    <!-- 关于页底部三条链，各自进一个独立页面；正文按小标题分段 -->
    <string name="privacy_title">隐私政策</string>
    <string name="terms_title">用户协议</string>
    <string name="stats_title">使用统计</string>

    <string name="privacy_h1">权限</string>
    <string name="privacy_b1">不申请运行时权限，不读取通讯录、位置、相机、麦克风、存储。修改 SIM 信息全部经 Shizuku，授权由你在 Shizuku 里给出。</string>
    <string name="privacy_h2">声明的权限分别用来做什么</string>
    <string name="privacy_b2">· 联网：检查更新、下载升级包\n· 开机自启：重启后补写你已保存的方案\n· 安装未知应用：把下载好的包交给系统安装器\n· MODIFY_PHONE_STATE / READ_PHONE_STATE：供 Shizuku 委托使用的系统级权限</string>
    <string name="privacy_h3">数据存在哪</string>
    <string name="privacy_b3">卡槽、国家码、自定义名称只存本机应用私有目录，不上传、不云备份，卸载即清空。</string>
    <string name="privacy_h4">什么时候联网</string>
    <string name="privacy_b4">你点「检查更新」那一次；公告每半小时最多复验一次（没有新内容时只花一次连接）；匿名统计每天最多一条（可关）。除此之外没有网络请求，无埋点、无广告、不传日志。</string>
    <string name="privacy_h5">不收集</string>
    <string name="privacy_b5">手机号、IMSI、ICCID、设备序列号、位置、账号、广告标识符，以及你填写和保存的任何内容。</string>

    <string name="terms_h1">这是什么</string>
    <string name="terms_b1">修改 SIM 卡在系统里显示的国家码与运营商名称，需配合 Shizuku。改的是系统读取到的配置，不写入卡本身，随时可还原。</string>
    <string name="terms_h2">这不是什么</string>
    <string name="terms_b2">不解锁网络锁，不改 IMEI，不提供任何解锁、破解或绕过计费的能力。</string>
    <string name="terms_h3">用途</string>
    <string name="terms_b3">仅供学习与研究，且只可用于你有权修改的设备与 SIM 卡。违法用途不支持，后果自负。</string>
    <string name="terms_h4">风险</string>
    <string name="terms_b4">可能影响通话、短信或数据服务；部分机型或运营商会拒绝还原，需要自行联系运营商处理。</string>
    <string name="terms_h5">免责</string>
    <string name="terms_b5">按「现状」提供，不含任何明示或暗示的担保（Apache-2.0 第 8 条）。</string>
    <string name="terms_h6">许可</string>
    <string name="terms_b6">代码以 Apache-2.0 开源，保留版权与许可声明即可自由使用与再分发；图标来自 Reicon（MIT）。</string>
    <string name="terms_h7">更新</string>
    <string name="terms_b7">以 GitHub Releases 为准，应用不会自动下载或安装任何东西。</string>

    <string name="stats_h1">上报什么</string>
    <string name="stats_b1">本机生成的匿名 ID、品牌机型、Android 版本、应用版本、界面语言。每天最多一条，只在启动时发送。</string>
    <string name="stats_h2">不上报什么</string>
    <string name="stats_b2">任何 SIM 内容与你的设置、位置、账号、硬件序列号。</string>
    <string name="stats_h3">用来做什么</string>
    <string name="stats_b3">只看在用人数，以及某个机型要不要继续适配。不看单台设备的历史。</string>
    <string name="stats_h4">保留多久</string>
    <string name="stats_b4">事件 45 天，按天汇总 400 天，设备行一年不活跃自动删除。</string>
    <string name="stats_h5">关掉</string>
    <string name="stats_b5">立即停止上报；已上报的按上面的期限自然消失。不影响公告和更新提示。</string>

    <!-- 首页帮助弹层：使用提示从关于页搬来，就地看，不用跳走 -->
