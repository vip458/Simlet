<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景层。几何与 brand/svg/simlet-icon.svg 同源：同一批路径写在 512 画布上，
  再用 group 的缩放搬进 108 的自适应画布。0.1746 = 32.2 / 184.4（卡角到中心的距离），
  这样卡的四个角落在 66dp 可见圆里，被圆形蒙版切掉的是底而不是卡。
  改形状请连 brand/svg 一起改，两边不要各画一套。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.1746"
        android:scaleY="0.1746"
        android:translateX="-202"
        android:translateY="-202">
        <!-- SIM 卡：左上 76 斜切 -->
        <path
            android:fillColor="#FCFCFC"
            android:pathData="M222,116 L350,116 Q376,116 376,142 L376,370 Q376,396 350,396 L162,396 Q136,396 136,370 L136,202 Q136,192 143.07,184.93 L204.93,123.07 Q212,116 222,116 Z" />
        <!-- 双向箭头：上条向右、下条向左 -->
        <path
            android:strokeColor="#131313"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M200,228 L312,228 M284,200 L312,228 L284,256" />
        <path
            android:strokeColor="#131313"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M312,290 L200,290 M228,262 L200,290 L228,318" />
    </group>
</vector>
