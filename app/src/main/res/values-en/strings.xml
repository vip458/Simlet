    <!-- Three text links at the bottom of About, each opening its own page -->
    <string name="privacy_title">Privacy policy</string>
    <string name="terms_title">Terms of use</string>
    <string name="stats_title">Usage statistics</string>

    <string name="privacy_h1">Permissions</string>
    <string name="privacy_b1">No runtime permissions are requested, and contacts, location, camera, microphone and storage are never read. Every SIM change goes through Shizuku, which you authorize inside Shizuku.</string>
    <string name="privacy_h2">What each declared permission is for</string>
    <string name="privacy_b2">· Internet — checking for updates and downloading the package\n· Boot — re-applying the plan you saved after a reboot\n· Install unknown apps — handing the downloaded file to the system installer\n· MODIFY_PHONE_STATE / READ_PHONE_STATE — privileged permissions used by Shizuku\'s delegation</string>
    <string name="privacy_h3">Where your data lives</string>
    <string name="privacy_b3">Slot, country code and the name you set stay in this app\'s private directory. Nothing is uploaded or backed up to a cloud; uninstalling clears it.</string>
    <string name="privacy_h4">When it touches the network</string>
    <string name="privacy_b4">The update check when you tap it; a notice re-check at most every half hour, which costs one connection when nothing changed; one anonymous usage record a day, which you can turn off. Nothing else makes a request — no analytics, no ads, no log upload.</string>
    <string name="privacy_h5">Never collected</string>
    <string name="privacy_b5">Phone number, IMSI, ICCID, hardware serial, location, accounts, advertising identifiers, and anything you type or save.</string>

    <string name="terms_h1">What this is</string>
    <string name="terms_b1">Changes the country code and carrier name a SIM shows in the system, working with Shizuku. It edits the configuration the system reads, not the SIM card itself, and can be restored at any time.</string>
    <string name="terms_h2">What this is not</string>
    <string name="terms_b2">No network unlocking, no IMEI changes, no unlocking, cracking or billing-evasion capability.</string>
    <string name="terms_h3">Use</string>
    <string name="terms_b3">For learning and research only, and only on devices and SIM cards you are entitled to modify. Unlawful use is not supported and is at your own risk.</string>
    <string name="terms_h4">Risk</string>
    <string name="terms_b4">It can affect calls, SMS or mobile data; some devices and carriers refuse to restore, which you would need to settle with your carrier.</string>
    <string name="terms_h5">No warranty</string>
    <string name="terms_b5">Provided \"AS IS\", without warranties or conditions of any kind, express or implied (Apache-2.0, section 8).</string>
    <string name="terms_h6">Licence</string>
    <string name="terms_b6">Open source under Apache-2.0 — use, modify and redistribute freely as long as the copyright and licence notices stay. Icons come from Reicon (MIT).</string>
    <string name="terms_h7">Updates</string>
    <string name="terms_b7">GitHub Releases is authoritative. The app never downloads or installs anything by itself.</string>

    <string name="stats_h1">What is reported</string>
    <string name="stats_b1">An anonymous ID generated on this device, brand and model, Android version, app version and language. At most one record a day, sent when the app starts.</string>
    <string name="stats_h2">What is not reported</string>
    <string name="stats_b2">Anything about your SIMs or your settings, location, accounts, hardware serials.</string>
    <string name="stats_h3">Why it is collected</string>
    <string name="stats_b3">Only two questions: how many people still use it, and whether a device model is worth keeping supported. No single device\'s history is looked at.</string>
    <string name="stats_h4">How long it is kept</string>
    <string name="stats_b4">Events 45 days, daily aggregates 400 days, and a device row is deleted after a year of no activity.</string>
    <string name="stats_h5">Turning it off</string>
    <string name="stats_b5">Reporting stops immediately; what was already sent expires on the schedule above. Notices and update prompts are unaffected.</string>

    <!-- 首页帮助弹层 -->
    <string name="help_title">Usage tips</string>
    <string name="help_body">· After saving, toggle airplane mode once so the carrier config is re-read\n· Overrides are re-applied automatically once after a reboot\n· Dual-SIM devices can be set per card, independently\n· Some custom ROMs block the interface at framework level; failing there is normal</string>

